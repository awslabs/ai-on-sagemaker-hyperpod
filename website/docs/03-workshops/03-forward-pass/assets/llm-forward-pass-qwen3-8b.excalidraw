      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "GQA: Grouped-Query Attention\n\n32 Q heads / 8 KV heads\n= groups of 4\n\nEvery 4 Q heads share\n1 K head + 1 V head",
      "roughness": 1,
      "roundness": null,
      "seed": 1831179336,
      "strokeColor": "#9c36b5",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "GQA: Grouped-Query Attention\n\n32 Q heads / 8 KV heads\n= groups of 4\n\nEvery 4 Q heads share\n1 K head + 1 V head",
      "textAlign": "center",
      "updated": 1788190280319,
      "version": 1,
      "versionNonce": 1865611858,
      "verticalAlign": "middle"
    },
    {
      "id": "d2-size-note",
      "type": "text",
      "x": 960,
      "y": 1240,
      "width": 252,
      "height": 105,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 14,
      "frameId": null,
      "groupIds": [],
      "index": "a70",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "W_Q has 16M params (4096x4096)\nW_K has 4M params (4096x1024)\nW_V has 4M params (4096x1024)\n\nKV cache is 4x smaller than\nfull multi-head attention",
      "roughness": 1,
      "roundness": null,
      "seed": 232960500,
      "strokeColor": "#868e96",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "W_Q has 16M params (4096x4096)\nW_K has 4M params (4096x1024)\nW_V has 4M params (4096x1024)\n\nKV cache is 4x smaller than\nfull multi-head attention",
      "textAlign": "center",
