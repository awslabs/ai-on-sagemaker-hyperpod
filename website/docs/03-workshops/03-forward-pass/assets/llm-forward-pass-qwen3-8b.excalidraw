      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "This runs for all 32 Q heads\n(with shared KV across groups of 4).\n\nAll 32 head outputs are\nconcatenated and projected:\n\nConcat(head_1,...,head_32) . W_O\n[5 x 4096]    x   [4096 x 4096]\n= final attention output [5 x 4096]",
      "roughness": 1,
      "roundness": null,
      "seed": 419418870,
      "strokeColor": "#868e96",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "This runs for all 32 Q heads\n(with shared KV across groups of 4).\n\nAll 32 head outputs are\nconcatenated and projected:\n\nConcat(head_1,...,head_32) . W_O\n[5 x 4096]    x   [4096 x 4096]\n= final attention output [5 x 4096]",
      "textAlign": "center",
      "updated": 1788190363587,
      "version": 1,
      "versionNonce": 130765184,
      "verticalAlign": "middle"
    },
